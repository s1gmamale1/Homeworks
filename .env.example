# AI backend — Kimi (Moonshot) is the global primary. Per-task overrides live
# in ai_gateway.TASK_PROVIDER_PREFERENCE (e.g. dynamic boss → openai).
AI_BACKEND_PREFERENCE=kimi

# --- Kimi / Moonshot (primary backend) ---
# Note: defaults switched from kimi-k2-turbo-preview (pre-F0 historical) to
# the moonshot-v1-* series. Override via KIMI_MODEL_FAST / KIMI_MODEL_PRO if
# you have access to k2-turbo or want to pin a different model.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL_FAST=moonshot-v1-32k
KIMI_MODEL_PRO=moonshot-v1-128k

# --- OpenAI (dynamic boss only; better Uzbek/Russian than Kimi) ---
# Routed via ai_gateway.TASK_PROVIDER_PREFERENCE for BOSS_QUESTION_GENERATE
# and BOSS_ANSWER_CHECK tasks. If OPENAI_API_KEY is empty the boss falls
# back to Kimi automatically — no boss outage.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_PRO=gpt-4o-mini
OPENAI_TIMEOUT=20

# --- Server ---
PORT=8000
DEBUG=true
