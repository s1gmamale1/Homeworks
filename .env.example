# AI backend — at least one of these must be configured.
# Priority order controlled by AI_BACKEND_PREFERENCE (Wave F0).

# --- AI backend selection (Wave F0) ---
# Comma-separated priority list; first available provider wins.
# Valid names: kimi, vertex, gemini_api.
AI_BACKEND_PREFERENCE=kimi,vertex,gemini_api

# --- Kimi / Moonshot (primary — Wave F0) ---
# Note: defaults switched from kimi-k2-turbo-preview (pre-F0 historical) to
# the moonshot-v1-* series. Override via KIMI_MODEL_FAST / KIMI_MODEL_PRO if
# you have access to k2-turbo or want to pin a different model.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL_FAST=moonshot-v1-32k
KIMI_MODEL_PRO=moonshot-v1-128k

# --- Vertex AI (fallback 1) ---
# Absolute path to service account JSON key.
VERTEX_CREDENTIALS_PATH=C:/Users/DaddysHere/Documents/claw_api_service.json
# Optional overrides (project_id is auto-read from JSON if not set here)
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

# --- Gemini API key (fallback 2) ---
GEMINI_API_KEY=

# --- Server ---
PORT=8000
DEBUG=true
